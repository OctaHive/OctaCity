{
  "schemas": {
    "spec_gate_input": {
      "identity": "factory.base.spec_gate_input",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "allowed_paths": {
            "required": true,
            "value": {
              "type": "array",
              "item": {
                "type": "string",
                "min_bytes": 1,
                "max_bytes": 1024
              },
              "min_items": 1,
              "max_items": 16
            }
          },
          "output_deadlines": {
            "required": true,
            "value": {
              "type": "object",
              "fields": {
                "capture": {
                  "required": true,
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  }
                },
                "handoff": {
                  "required": true,
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  }
                },
                "facts": {
                  "required": true,
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  }
                }
              }
            }
          },
          "work_id": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 256
            }
          },
          "original_base": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 256
            }
          },
          "work_kind": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "feature_request",
                "defect"
              ]
            }
          },
          "expected_input": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 64
            }
          },
          "handoff_digest": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 64
            }
          },
          "manifest": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "spec_manifest"
            }
          },
          "handoff": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "spec_handoff"
            }
          },
          "facts": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "spec_facts"
            }
          },
          "artifacts": {
            "required": true,
            "value": {
              "type": "object",
              "fields": {
                "manifest": {
                  "required": true,
                  "value": {
                    "type": "reference",
                    "schema": "artifact_reference"
                  }
                },
                "bundle": {
                  "required": true,
                  "value": {
                    "type": "reference",
                    "schema": "artifact_reference"
                  }
                }
              }
            }
          },
          "declared_requirements": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "declared_requirements"
            }
          },
          "expected_predecessor": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 256
            }
          }
        }
      }
    }
  }
}
