{
  "schemas": {
    "classification_gate_input": {
      "identity": "factory.base.classification_gate_input",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "work_kind": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "defect",
                "feature_request"
              ]
            }
          },
          "size": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "small",
                "medium",
                "large"
              ]
            }
          },
          "risk": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            }
          },
          "admission_risk": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            }
          },
          "recommended_route": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 128
            }
          },
          "reproducibility": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "reproduced",
                "not_reproduced",
                "needs_human_input",
                "not_applicable"
              ]
            }
          },
          "reproduced_verified": {
            "required": true,
            "value": {
              "type": "boolean"
            }
          },
          "already_fixed_verified": {
            "required": true,
            "value": {
              "type": "boolean"
            }
          },
          "verification_only_verified": {
            "required": true,
            "value": {
              "type": "boolean"
            }
          },
          "expected_input": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 64,
              "max_bytes": 64
            }
          },
          "evidence_input": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 64,
              "max_bytes": 64
            }
          },
          "fresh_until": {
            "required": true,
            "value": {
              "type": "integer",
              "minimum": -62135596800000,
              "maximum": 253402300799999
            }
          },
          "component": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 128
            }
          },
          "severity": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "advisory",
                "low",
                "medium",
                "high",
                "critical"
              ]
            }
          },
          "dependencies": {
            "required": true,
            "value": {
              "type": "array",
              "min_items": 0,
              "max_items": 64,
              "item": {
                "type": "object",
                "fields": {
                  "run_id": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 36,
                      "max_bytes": 36
                    }
                  },
                  "work_id": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 36,
                      "max_bytes": 36
                    }
                  },
                  "work_digest": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 64,
                      "max_bytes": 64
                    }
                  },
                  "terminal": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 1,
                      "max_bytes": 128
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
