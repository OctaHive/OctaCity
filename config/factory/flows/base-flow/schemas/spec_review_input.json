{
  "schemas": {
    "spec_review_input": {
      "identity": "factory.base.spec_review_input",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "request": {
            "required": true,
            "value": {
              "type": "object",
              "fields": {
                "work_id": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 1,
                    "max_bytes": 256
                  }
                },
                "original_base": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 1,
                    "max_bytes": 256
                  }
                },
                "candidate_revision": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 1,
                    "max_bytes": 256
                  }
                },
                "manifest_digest": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 64,
                    "max_bytes": 64
                  }
                },
                "bundle_digest": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 64,
                    "max_bytes": 64
                  }
                }
              }
            }
          },
          "artifacts": {
            "required": true,
            "value": {
              "type": "object",
              "fields": {
                "manifest": {
                  "required": true,
                  "value": {
                    "type": "reference",
                    "schema": "artifact_reference"
                  }
                },
                "bundle": {
                  "required": true,
                  "value": {
                    "type": "reference",
                    "schema": "artifact_reference"
                  }
                }
              }
            }
          },
          "acceptance_criteria": {
            "required": true,
            "value": {
              "type": "array",
              "min_items": 1,
              "max_items": 32,
              "item": {
                "type": "string",
                "min_bytes": 1,
                "max_bytes": 2048
              }
            }
          },
          "regression_criteria": {
            "required": true,
            "value": {
              "type": "array",
              "min_items": 0,
              "max_items": 32,
              "item": {
                "type": "string",
                "min_bytes": 1,
                "max_bytes": 2048
              }
            }
          },
          "original_acceptance": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "artifact_reference"
            }
          },
          "declared_requirements": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "declared_requirements"
            }
          }
        }
      }
    }
  }
}
