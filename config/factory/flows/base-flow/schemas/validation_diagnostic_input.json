{
  "schemas": {
    "validation_diagnostic_input": {
      "identity": "factory.base.validation_diagnostic_input",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "summary": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "summary"
            }
          },
          "candidate_revision": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 256
            }
          },
          "candidate_digest": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 64,
              "max_bytes": 64
            }
          },
          "validation_digest": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 64,
              "max_bytes": 64
            }
          },
          "classes": {
            "required": true,
            "value": {
              "type": "array",
              "item": {
                "type": "object",
                "fields": {
                  "class": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 1,
                      "max_bytes": 96
                    }
                  },
                  "outcome": {
                    "required": true,
                    "value": {
                      "type": "enum",
                      "values": [
                        "passed",
                        "failed",
                        "indeterminate"
                      ]
                    }
                  }
                }
              },
              "min_items": 1,
              "max_items": 64
            }
          }
        }
      }
    }
  }
}
