{
  "schemas": {
    "spec_author_input": {
      "identity": "factory.base.spec_author_input",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "work_id": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 256
            }
          },
          "original_base": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 256
            }
          },
          "accepted_input": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "summary"
            }
          },
          "allowed_paths": {
            "required": true,
            "value": {
              "type": "array",
              "item": {
                "type": "string",
                "min_bytes": 1,
                "max_bytes": 1024
              },
              "min_items": 1,
              "max_items": 16
            }
          },
          "declared_requirements": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "declared_requirements"
            }
          },
          "task": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "artifact_reference"
            }
          },
          "original_acceptance": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "artifact_reference"
            }
          }
        }
      }
    }
  }
}
