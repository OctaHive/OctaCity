{
  "schemas": {
    "spec_review_gate_input": {
      "identity": "factory.base.spec_review_gate_input",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "request": {
            "required": true,
            "value": {
              "type": "object",
              "fields": {
                "work_id": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 1,
                    "max_bytes": 256
                  }
                },
                "original_base": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 1,
                    "max_bytes": 256
                  }
                },
                "candidate_revision": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 1,
                    "max_bytes": 256
                  }
                },
                "manifest_digest": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 64,
                    "max_bytes": 64
                  }
                },
                "bundle_digest": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 64,
                    "max_bytes": 64
                  }
                }
              }
            }
          },
          "expected_input": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 64,
              "max_bytes": 64
            }
          },
          "review_digest": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 64,
              "max_bytes": 64
            }
          },
          "review": {
            "required": true,
            "value": {
              "type": "object",
              "fields": {
                "work_id": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 1,
                    "max_bytes": 256
                  }
                },
                "original_base": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 1,
                    "max_bytes": 256
                  }
                },
                "candidate_revision": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 1,
                    "max_bytes": 256
                  }
                },
                "manifest_digest": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 64,
                    "max_bytes": 64
                  }
                },
                "bundle_digest": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 64,
                    "max_bytes": 64
                  }
                },
                "input_digest": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 64,
                    "max_bytes": 64
                  }
                },
                "quality": {
                  "required": true,
                  "value": {
                    "type": "object",
                    "fields": {
                      "complete": {
                        "required": true,
                        "value": {
                          "type": "enum",
                          "values": [
                            "satisfied",
                            "violated",
                            "indeterminate"
                          ]
                        }
                      },
                      "consistent": {
                        "required": true,
                        "value": {
                          "type": "enum",
                          "values": [
                            "satisfied",
                            "violated",
                            "indeterminate"
                          ]
                        }
                      },
                      "feasible": {
                        "required": true,
                        "value": {
                          "type": "enum",
                          "values": [
                            "satisfied",
                            "violated",
                            "indeterminate"
                          ]
                        }
                      },
                      "testable": {
                        "required": true,
                        "value": {
                          "type": "enum",
                          "values": [
                            "satisfied",
                            "violated",
                            "indeterminate"
                          ]
                        }
                      },
                      "in_scope": {
                        "required": true,
                        "value": {
                          "type": "enum",
                          "values": [
                            "satisfied",
                            "violated",
                            "indeterminate"
                          ]
                        }
                      }
                    }
                  }
                },
                "findings": {
                  "required": true,
                  "value": {
                    "type": "array",
                    "min_items": 0,
                    "max_items": 32,
                    "item": {
                      "type": "object",
                      "fields": {
                        "criterion": {
                          "required": true,
                          "value": {
                            "type": "enum",
                            "values": [
                              "complete",
                              "consistent",
                              "feasible",
                              "testable",
                              "in_scope"
                            ]
                          }
                        },
                        "finding": {
                          "required": true,
                          "value": {
                            "type": "string",
                            "min_bytes": 1,
                            "max_bytes": 2048
                          }
                        },
                        "remediation": {
                          "required": true,
                          "value": {
                            "type": "string",
                            "min_bytes": 0,
                            "max_bytes": 2048
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "facts": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "spec_review_facts"
            }
          },
          "output_deadlines": {
            "required": true,
            "value": {
              "type": "object",
              "fields": {
                "review": {
                  "required": true,
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "facts": {
                  "required": true,
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
