{
  "schemas": {
    "summary": {
      "identity": "factory.base.summary",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "work_kind": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "defect",
                "feature_request"
              ]
            }
          },
          "size": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "small",
                "medium",
                "large"
              ]
            }
          },
          "risk": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            }
          },
          "admission_risk": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            }
          },
          "recommended_route": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 128
            }
          },
          "research_required": {
            "required": true,
            "value": {
              "type": "boolean"
            }
          },
          "research_accepted": {
            "required": true,
            "value": {
              "type": "boolean"
            }
          },
          "component": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 128
            }
          },
          "severity": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "advisory",
                "low",
                "medium",
                "high",
                "critical"
              ]
            }
          },
          "dependencies": {
            "required": true,
            "value": {
              "type": "array",
              "min_items": 0,
              "max_items": 64,
              "item": {
                "type": "object",
                "fields": {
                  "run_id": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 36,
                      "max_bytes": 36
                    }
                  },
                  "work_id": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 36,
                      "max_bytes": 36
                    }
                  },
                  "work_digest": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 64,
                      "max_bytes": 64
                    }
                  },
                  "terminal": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 1,
                      "max_bytes": 128
                    }
                  }
                }
              }
            }
          },
          "specification": {
            "required": false,
            "value": {
              "type": "reference",
              "schema": "spec_result"
            }
          },
          "requirements_defect": {
            "required": false,
            "value": {
              "type": "object",
              "fields": {
                "reason": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 1,
                    "max_bytes": 2048
                  }
                },
                "candidate_revision": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 1,
                    "max_bytes": 256
                  }
                },
                "evidence": {
                  "required": true,
                  "value": {
                    "type": "array",
                    "min_items": 1,
                    "max_items": 16,
                    "item": {
                      "type": "reference",
                      "schema": "artifact_reference"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
