{
  "schemas": {
    "defect_observations": {
      "identity": "factory.base.defect_observations",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "outcome": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "reproduced",
                "intermittent",
                "environment_specific",
                "cannot_reproduce",
                "already_fixed",
                "needs_human_input"
              ]
            }
          },
          "summary": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 2048
            }
          }
        }
      }
    }
  }
}
