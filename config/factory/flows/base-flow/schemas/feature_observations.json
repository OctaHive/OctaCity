{
  "schemas": {
    "feature_observations": {
      "identity": "factory.base.feature_observations",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "outcome": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "proposed",
                "already_fixed",
                "needs_human_input"
              ]
            }
          },
          "problem": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 2048
            }
          },
          "acceptance_boundary": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 2048
            }
          },
          "out_of_scope": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 2048
            }
          }
        }
      }
    }
  }
}
