{
  "schemas": {
    "code_review_gate_input": {
      "identity": "factory.base.code_review_gate_input",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "request": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "code_review_input"
            }
          },
          "review": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "code_review"
            }
          },
          "expected_input": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 64,
              "max_bytes": 64
            }
          },
          "expected_report": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 64,
              "max_bytes": 64
            }
          },
          "facts": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "spec_review_facts"
            }
          },
          "output_deadlines": {
            "required": true,
            "value": {
              "type": "object",
              "fields": {
                "review": {
                  "required": true,
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "facts": {
                  "required": true,
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
