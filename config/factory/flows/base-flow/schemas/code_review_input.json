{
  "schemas": {
    "code_review_input": {
      "identity": "factory.base.code_review_input",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "summary": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "summary"
            }
          },
          "candidate_revision": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 256
            }
          },
          "candidate_digest": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 64,
              "max_bytes": 64
            }
          },
          "task": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "artifact_reference"
            }
          },
          "manifest": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "artifact_reference"
            }
          },
          "bundle": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "artifact_reference"
            }
          }
        }
      }
    }
  }
}
