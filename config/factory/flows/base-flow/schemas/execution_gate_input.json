{
  "schemas": {
    "execution_gate_input": {
      "identity": "factory.base.execution_gate_input",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "result": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "summary"
            }
          },
          "facts": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "execution_facts"
            }
          },
          "expected_input": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 64
            }
          },
          "expected_report": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 64
            }
          },
          "trusted_input": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "summary"
            }
          },
          "execution_revision": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 256
            }
          }
        }
      }
    }
  }
}
