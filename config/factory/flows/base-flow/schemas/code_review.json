{
  "schemas": {
    "code_review": {
      "identity": "factory.base.code_review",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "candidate_revision": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 256
            }
          },
          "candidate_digest": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 64,
              "max_bytes": 64
            }
          },
          "input_digest": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 64,
              "max_bytes": 64
            }
          },
          "quality": {
            "required": true,
            "value": {
              "type": "object",
              "fields": {
                "correctness": {
                  "required": true,
                  "value": {
                    "type": "enum",
                    "values": [
                      "satisfied",
                      "violated",
                      "indeterminate"
                    ]
                  }
                },
                "maintainability": {
                  "required": true,
                  "value": {
                    "type": "enum",
                    "values": [
                      "satisfied",
                      "violated",
                      "indeterminate"
                    ]
                  }
                },
                "public_tests": {
                  "required": true,
                  "value": {
                    "type": "enum",
                    "values": [
                      "satisfied",
                      "violated",
                      "indeterminate"
                    ]
                  }
                },
                "security": {
                  "required": true,
                  "value": {
                    "type": "enum",
                    "values": [
                      "satisfied",
                      "violated",
                      "indeterminate"
                    ]
                  }
                }
              }
            }
          },
          "findings": {
            "required": true,
            "value": {
              "type": "array",
              "item": {
                "type": "string",
                "min_bytes": 1,
                "max_bytes": 2048
              },
              "min_items": 0,
              "max_items": 32
            }
          }
        }
      }
    }
  }
}
