{
  "schemas": {
    "spec_result": {
      "identity": "factory.base.spec_result",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "work_id": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 256
            }
          },
          "original_base": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 256
            }
          },
          "manifest": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "spec_manifest"
            }
          },
          "handoff": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "spec_handoff"
            }
          },
          "readiness": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "review_pending"
              ]
            }
          },
          "artifacts": {
            "required": true,
            "value": {
              "type": "object",
              "fields": {
                "manifest": {
                  "required": true,
                  "value": {
                    "type": "reference",
                    "schema": "artifact_reference"
                  }
                },
                "bundle": {
                  "required": true,
                  "value": {
                    "type": "reference",
                    "schema": "artifact_reference"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
