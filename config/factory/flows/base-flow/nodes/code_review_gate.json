{
  "nodes": [
    {
      "key": "code_review_gate",
      "kind": "deterministic_gate",
      "input_schema": "code_review_gate_input",
      "outcomes": [
        {
          "key": "accepted",
          "kind": "success",
          "schema": "summary"
        },
        {
          "key": "changes_required",
          "kind": "failure",
          "schema": "summary"
        },
        {
          "key": "needs_human_input",
          "kind": "failure",
          "schema": "summary"
        },
        {
          "key": "invalid",
          "kind": "failure",
          "schema": "summary"
        }
      ],
      "budget": {
        "max_attempts": 1,
        "max_elapsed_millis": 60000,
        "max_tokens": 10000,
        "max_cost_micro_units": 1000000,
        "max_output_bytes": 1048576
      },
      "required": true,
      "input_binding": {
        "sources": {
          "request": {
            "source": "predecessor",
            "view": "input_payload",
            "path": ""
          },
          "review": {
            "source": "predecessor",
            "view": "payload",
            "path": ""
          },
          "metadata": {
            "source": "predecessor",
            "view": "metadata",
            "path": ""
          }
        },
        "mapping": {
          "value": {
            "mapping": "object",
            "fields": {
              "request": {
                "mapping": "pointer",
                "path": "/request"
              },
              "review": {
                "mapping": "pointer",
                "path": "/review"
              },
              "expected_input": {
                "mapping": "pointer",
                "path": "/metadata/input_digest"
              },
              "expected_report": {
                "mapping": "pointer",
                "path": "/metadata/build/outputs/code_review/artifact/content_digest"
              },
              "facts": {
                "mapping": "pointer",
                "path": "/metadata/build/outputs/code_review_facts/data/payload/value"
              },
              "output_deadlines": {
                "mapping": "object",
                "fields": {
                  "review": {
                    "mapping": "pointer",
                    "path": "/metadata/build/outputs/code_review/fresh_until"
                  },
                  "facts": {
                    "mapping": "pointer",
                    "path": "/metadata/build/outputs/code_review_facts/fresh_until"
                  }
                }
              }
            }
          }
        }
      },
      "gate": {
        "precondition": {
          "operation": "all",
          "predicates": [
            {
              "operation": "compare",
              "left": {
                "source": "path",
                "path": "/facts/accepted"
              },
              "comparison": "equal",
              "right": {
                "source": "literal",
                "value": true
              }
            },
            {
              "operation": "compare",
              "left": {
                "source": "path",
                "path": "/expected_input"
              },
              "comparison": "equal",
              "right": {
                "source": "path",
                "path": "/facts/input_digest"
              }
            },
            {
              "operation": "compare",
              "left": {
                "source": "path",
                "path": "/expected_input"
              },
              "comparison": "equal",
              "right": {
                "source": "path",
                "path": "/review/input_digest"
              }
            },
            {
              "operation": "compare",
              "left": {
                "source": "path",
                "path": "/expected_report"
              },
              "comparison": "equal",
              "right": {
                "source": "path",
                "path": "/facts/report_digest"
              }
            },
            {
              "operation": "compare",
              "left": {
                "source": "path",
                "path": "/request/candidate_revision"
              },
              "comparison": "equal",
              "right": {
                "source": "path",
                "path": "/review/candidate_revision"
              }
            },
            {
              "operation": "compare",
              "left": {
                "source": "path",
                "path": "/request/candidate_digest"
              },
              "comparison": "equal",
              "right": {
                "source": "path",
                "path": "/review/candidate_digest"
              }
            },
            {
              "operation": "compare",
              "left": {
                "source": "path",
                "path": "/facts/fresh_until"
              },
              "comparison": "greater",
              "right": {
                "source": "observation_time"
              }
            },
            {
              "operation": "compare",
              "left": {
                "source": "path",
                "path": "/output_deadlines/review"
              },
              "comparison": "greater",
              "right": {
                "source": "observation_time"
              }
            },
            {
              "operation": "compare",
              "left": {
                "source": "path",
                "path": "/output_deadlines/facts"
              },
              "comparison": "greater",
              "right": {
                "source": "observation_time"
              }
            }
          ]
        },
        "rules": [
          {
            "when": {
              "operation": "all",
              "predicates": [
                {
                  "operation": "compare",
                  "left": {
                    "source": "path",
                    "path": "/review/quality/correctness"
                  },
                  "comparison": "equal",
                  "right": {
                    "source": "literal",
                    "value": "satisfied"
                  }
                },
                {
                  "operation": "compare",
                  "left": {
                    "source": "path",
                    "path": "/review/quality/maintainability"
                  },
                  "comparison": "equal",
                  "right": {
                    "source": "literal",
                    "value": "satisfied"
                  }
                },
                {
                  "operation": "compare",
                  "left": {
                    "source": "path",
                    "path": "/review/quality/public_tests"
                  },
                  "comparison": "equal",
                  "right": {
                    "source": "literal",
                    "value": "satisfied"
                  }
                },
                {
                  "operation": "compare",
                  "left": {
                    "source": "path",
                    "path": "/review/quality/security"
                  },
                  "comparison": "equal",
                  "right": {
                    "source": "literal",
                    "value": "satisfied"
                  }
                }
              ]
            },
            "outcome": "accepted"
          },
          {
            "when": {
              "operation": "any",
              "predicates": [
                {
                  "operation": "compare",
                  "left": {
                    "source": "path",
                    "path": "/review/quality/correctness"
                  },
                  "comparison": "equal",
                  "right": {
                    "source": "literal",
                    "value": "violated"
                  }
                },
                {
                  "operation": "compare",
                  "left": {
                    "source": "path",
                    "path": "/review/quality/maintainability"
                  },
                  "comparison": "equal",
                  "right": {
                    "source": "literal",
                    "value": "violated"
                  }
                },
                {
                  "operation": "compare",
                  "left": {
                    "source": "path",
                    "path": "/review/quality/public_tests"
                  },
                  "comparison": "equal",
                  "right": {
                    "source": "literal",
                    "value": "violated"
                  }
                },
                {
                  "operation": "compare",
                  "left": {
                    "source": "path",
                    "path": "/review/quality/security"
                  },
                  "comparison": "equal",
                  "right": {
                    "source": "literal",
                    "value": "violated"
                  }
                }
              ]
            },
            "outcome": "changes_required"
          },
          {
            "when": {
              "operation": "any",
              "predicates": [
                {
                  "operation": "compare",
                  "left": {
                    "source": "path",
                    "path": "/review/quality/correctness"
                  },
                  "comparison": "equal",
                  "right": {
                    "source": "literal",
                    "value": "indeterminate"
                  }
                },
                {
                  "operation": "compare",
                  "left": {
                    "source": "path",
                    "path": "/review/quality/maintainability"
                  },
                  "comparison": "equal",
                  "right": {
                    "source": "literal",
                    "value": "indeterminate"
                  }
                },
                {
                  "operation": "compare",
                  "left": {
                    "source": "path",
                    "path": "/review/quality/public_tests"
                  },
                  "comparison": "equal",
                  "right": {
                    "source": "literal",
                    "value": "indeterminate"
                  }
                },
                {
                  "operation": "compare",
                  "left": {
                    "source": "path",
                    "path": "/review/quality/security"
                  },
                  "comparison": "equal",
                  "right": {
                    "source": "literal",
                    "value": "indeterminate"
                  }
                }
              ]
            },
            "outcome": "needs_human_input"
          }
        ],
        "fallback": "invalid",
        "default_output": {
          "value": {
            "mapping": "pointer",
            "path": "/request/summary"
          }
        }
      }
    }
  ]
}
