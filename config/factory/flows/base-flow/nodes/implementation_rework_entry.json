{
  "nodes": [
    {
      "key": "implementation_rework_entry",
      "kind": "deterministic_gate",
      "input_schema": "implementation_input",
      "outcomes": [
        {
          "key": "ready",
          "kind": "success",
          "schema": "implementation_input"
        }
      ],
      "budget": {
        "max_attempts": 1,
        "max_elapsed_millis": 1000,
        "max_tokens": 0,
        "max_cost_micro_units": 0,
        "max_output_bytes": 1048576
      },
      "required": true,
      "input_binding": {
        "sources": {
          "original": {
            "source": "record",
            "node": "implementation",
            "outcome": "observed",
            "view": "input_payload",
            "path": ""
          },
          "candidate": {
            "source": "record",
            "node": "implementation",
            "outcome": "observed",
            "view": "metadata",
            "path": "/build/outputs/candidate_facts/data/payload/value"
          },
          "manifest": {
            "source": "record",
            "node": "implementation",
            "outcome": "observed",
            "view": "metadata",
            "path": "/build/outputs/change-set-manifest.json/artifact"
          },
          "bundle": {
            "source": "record",
            "node": "implementation",
            "outcome": "observed",
            "view": "metadata",
            "path": "/build/outputs/change-set.bundle/artifact"
          },
          "failure": {
            "source": "predecessor",
            "view": "input_payload",
            "path": ""
          },
          "acceptance": {
            "source": "work",
            "path": "/artifacts/acceptance"
          }
        },
        "mapping": {
          "value": {
            "mapping": "object",
            "fields": {
              "accepted": {
                "mapping": "pointer",
                "path": "/original/accepted"
              },
              "task": {
                "mapping": "pointer",
                "path": "/original/task"
              },
              "parent": {
                "mapping": "object",
                "fields": {
                  "candidate_revision": {
                    "mapping": "pointer",
                    "path": "/candidate/candidate_revision"
                  },
                  "candidate_digest": {
                    "mapping": "pointer",
                    "path": "/candidate/candidate_digest"
                  },
                  "manifest": {
                    "mapping": "pointer",
                    "path": "/manifest"
                  },
                  "bundle": {
                    "mapping": "pointer",
                    "path": "/bundle"
                  }
                }
              },
              "remediation": {
                "mapping": "if_present",
                "path": "/failure/review",
                "then": {
                  "mapping": "if_present",
                  "path": "/failure/review/findings/0",
                  "then": {
                    "mapping": "pointer",
                    "path": "/failure/review/findings"
                  },
                  "otherwise": {
                    "mapping": "constant",
                    "value": ["Address the violated code-review criteria"]
                  }
                },
                "otherwise": {
                  "mapping": "array",
                  "items": [
                    {
                      "mapping": "pointer",
                      "path": "/failure/classification/remediation"
                    }
                  ]
                }
              },
              "accepted_contract": {
                "mapping": "pointer",
                "path": "/original/accepted_contract"
              },
              "test_scope": {
                "mapping": "pointer",
                "path": "/original/test_scope"
              },
              "original_acceptance": {
                "mapping": "pointer",
                "path": "/acceptance"
              }
            }
          }
        }
      },
      "gate": {
        "rules": [],
        "fallback": "ready",
        "default_output": {
          "value": {
            "mapping": "pointer",
            "path": ""
          }
        }
      }
    }
  ]
}
