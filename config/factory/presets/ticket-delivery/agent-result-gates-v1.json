{
  "schemas": {
    "delivery_code_review_gate_input": {
      "identity": "factory.delivery.code_review_gate_input",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "request": {"required": true,"value": {"type": "reference","schema": "code_review_input"}},
          "review": {"required": true,"value": {"type": "reference","schema": "code_review"}},
          "expected_input": {"required": true,"value": {"type": "string","min_bytes": 64,"max_bytes": 64}},
          "fresh_until": {"required": true,"value": {"type": "integer","minimum": 0,"maximum": 9007199254740991}}
        }
      }
    },
    "delivery_validation_classification_gate_input": {
      "identity": "factory.delivery.validation_classification_gate_input",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "request": {"required": true,"value": {"type": "reference","schema": "validation_diagnostic_input"}},
          "classification": {"required": true,"value": {"type": "reference","schema": "validation_classification"}},
          "expected_input": {"required": true,"value": {"type": "string","min_bytes": 64,"max_bytes": 64}},
          "fresh_until": {"required": true,"value": {"type": "integer","minimum": 0,"maximum": 9007199254740991}}
        }
      }
    }
  },
  "nodes": [
    {
      "key": "code_review_gate",
      "kind": "deterministic_gate",
      "input_schema": "delivery_code_review_gate_input",
      "outcomes": [
        {"key": "accepted","kind": "success","schema": "summary"},
        {"key": "changes_required","kind": "failure","schema": "summary"},
        {"key": "needs_human_input","kind": "failure","schema": "summary"},
        {"key": "invalid","kind": "failure","schema": "summary"}
      ],
      "budget": {
        "max_attempts": 1,
        "max_elapsed_millis": 60000,
        "max_tokens": 10000,
        "max_cost_micro_units": 1000000,
        "max_output_bytes": 1048576
      },
      "required": true,
      "input_binding": {
        "sources": {
          "request": {"source": "predecessor","view": "input_payload","path": ""},
          "review": {"source": "predecessor","view": "payload","path": ""},
          "metadata": {"source": "predecessor","view": "metadata","path": ""}
        },
        "mapping": {
          "value": {
            "mapping": "object",
            "fields": {
              "request": {"mapping": "pointer","path": "/request"},
              "review": {"mapping": "pointer","path": "/review"},
              "expected_input": {"mapping": "pointer","path": "/metadata/input_digest"},
              "fresh_until": {"mapping": "pointer","path": "/metadata/build/primary_fresh_until"}
            }
          }
        }
      }
    },
    {
      "key": "validation_classification_gate",
      "kind": "deterministic_gate",
      "input_schema": "delivery_validation_classification_gate_input",
      "outcomes": [
        {"key": "implementation_rework","kind": "failure","schema": "summary"},
        {"key": "requirements_correction","kind": "failure","schema": "summary"},
        {"key": "test_correction","kind": "failure","schema": "summary"},
        {"key": "escalation","kind": "failure","schema": "summary"},
        {"key": "rejection","kind": "failure","schema": "summary"},
        {"key": "invalid","kind": "failure","schema": "summary"}
      ],
      "budget": {
        "max_attempts": 1,
        "max_elapsed_millis": 60000,
        "max_tokens": 10000,
        "max_cost_micro_units": 1000000,
        "max_output_bytes": 1048576
      },
      "required": true,
      "input_binding": {
        "sources": {
          "request": {"source": "predecessor","view": "input_payload","path": "/request"},
          "classification": {"source": "predecessor","view": "payload","path": ""},
          "metadata": {"source": "predecessor","view": "metadata","path": ""}
        },
        "mapping": {
          "value": {
            "mapping": "object",
            "fields": {
              "request": {"mapping": "pointer","path": "/request"},
              "classification": {"mapping": "pointer","path": "/classification"},
              "expected_input": {"mapping": "pointer","path": "/metadata/input_digest"},
              "fresh_until": {"mapping": "pointer","path": "/metadata/build/primary_fresh_until"}
            }
          }
        }
      }
    }
  ],
  "gate_bindings": {
    "code_review_gate": {
      "program": "code_review_gate",
      "precondition": {
        "operation": "all",
        "predicates": [
          {
            "operation": "compare",
            "left": {
              "source": "path",
              "path": "/expected_input"
            },
            "comparison": "equal",
            "right": {
              "source": "path",
              "path": "/review/input_digest"
            }
          },
          {
            "operation": "compare",
            "left": {
              "source": "path",
              "path": "/request/candidate_revision"
            },
            "comparison": "equal",
            "right": {
              "source": "path",
              "path": "/review/candidate_revision"
            }
          },
          {
            "operation": "compare",
            "left": {
              "source": "path",
              "path": "/request/candidate_digest"
            },
            "comparison": "equal",
            "right": {
              "source": "path",
              "path": "/review/candidate_digest"
            }
          },
          {
            "operation": "compare",
            "left": {
              "source": "path",
              "path": "/fresh_until"
            },
            "comparison": "greater",
            "right": {
              "source": "observation_time"
            }
          }
        ]
      }
    },
    "validation_classification_gate": {
      "program": "validation_classification_gate",
      "precondition": {
        "operation": "all",
        "predicates": [
          {
            "operation": "compare",
            "left": {
              "source": "path",
              "path": "/expected_input"
            },
            "comparison": "equal",
            "right": {
              "source": "path",
              "path": "/classification/input_digest"
            }
          },
          {
            "operation": "compare",
            "left": {
              "source": "path",
              "path": "/request/candidate_revision"
            },
            "comparison": "equal",
            "right": {
              "source": "path",
              "path": "/classification/candidate_revision"
            }
          },
          {
            "operation": "compare",
            "left": {
              "source": "path",
              "path": "/request/candidate_digest"
            },
            "comparison": "equal",
            "right": {
              "source": "path",
              "path": "/classification/candidate_digest"
            }
          },
          {
            "operation": "compare",
            "left": {
              "source": "path",
              "path": "/request/validation_digest"
            },
            "comparison": "equal",
            "right": {
              "source": "path",
              "path": "/classification/validation_digest"
            }
          },
          {
            "operation": "compare",
            "left": {
              "source": "path",
              "path": "/fresh_until"
            },
            "comparison": "greater",
            "right": {
              "source": "observation_time"
            }
          }
        ]
      }
    }
  }
}
