{
  "schemas": {
    "implementation_capture_gate_input": {
      "identity": "factory.delivery.implementation_capture_gate_input",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "result": {"required": true, "value": {"type": "reference", "schema": "summary"}},
          "accepted": {"required": true, "value": {"type": "reference", "schema": "summary"}},
          "capture": {"required": true, "value": {"type": "reference", "schema": "candidate_capture_facts"}},
          "expected_input": {"required": true, "value": {"type": "string", "min_bytes": 64, "max_bytes": 64}},
          "primary_output": {"required": true, "value": {"type": "string", "min_bytes": 1, "max_bytes": 128}},
          "primary_fresh_until": {"required": true, "value": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}
        }
      }
    }
  },
  "nodes": [
    {
      "key": "implementation_result_gate",
      "kind": "deterministic_gate",
      "input_schema": "implementation_capture_gate_input",
      "outcomes": [
        {"key": "continue", "kind": "success", "schema": "summary"},
        {"key": "requirements_defect", "kind": "failure", "schema": "summary"},
        {"key": "invalid", "kind": "failure", "schema": "summary"}
      ],
      "budget": {"max_attempts": 1, "max_elapsed_millis": 1000, "max_tokens": 0, "max_cost_micro_units": 0, "max_output_bytes": 1048576},
      "required": true,
      "input_binding": {
        "sources": {
          "result": {"source": "predecessor", "view": "payload", "path": ""},
          "metadata": {"source": "predecessor", "view": "metadata", "path": ""},
          "accepted": {"source": "predecessor", "view": "input_payload", "path": "/accepted"}
        },
        "mapping": {"value": {"mapping": "object", "fields": {
          "result": {"mapping": "pointer", "path": "/result"},
          "accepted": {"mapping": "pointer", "path": "/accepted"},
          "capture": {"mapping": "pointer", "path": "/metadata/build/outputs/candidate_facts/data/payload/value"},
          "expected_input": {"mapping": "pointer", "path": "/metadata/input_digest"},
          "primary_output": {"mapping": "pointer", "path": "/metadata/build/profile/result_output"},
          "primary_fresh_until": {"mapping": "pointer", "path": "/metadata/build/primary_fresh_until"}
        }}}
      },
      "gate": {
        "precondition": {"operation": "all", "predicates": [
          {"operation": "compare", "left": {"source": "path", "path": "/primary_output"}, "comparison": "equal", "right": {"source": "literal", "value": "codex-run-result"}},
          {"operation": "compare", "left": {"source": "path", "path": "/capture/input_digest"}, "comparison": "equal", "right": {"source": "path", "path": "/expected_input"}},
          {"operation": "compare", "left": {"source": "path", "path": "/capture/fresh_until"}, "comparison": "greater", "right": {"source": "observation_time"}},
          {"operation": "compare", "left": {"source": "path", "path": "/primary_fresh_until"}, "comparison": "greater", "right": {"source": "observation_time"}}
        ]},
        "rules": [
          {"outcome": "requirements_defect", "when": {"operation": "exists", "operand": {"source": "path", "path": "/result/requirements_defect"}}},
          {"outcome": "continue", "when": {"operation": "absent", "path": "/result/requirements_defect"}}
        ],
        "fallback": "invalid",
        "default_output": {"value": {"mapping": "pointer", "path": "/accepted"}}
      }
    }
  ]
}
