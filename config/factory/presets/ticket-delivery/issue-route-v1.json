{
  "schemas": {
    "reproduction_route": {
      "identity": "factory.ticket-delivery.reproduction-route",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "work_kind": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "defect",
                "feature_request"
              ]
            }
          },
          "reproducibility": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "reproduced",
                "not_reproduced",
                "unknown",
                "needs_research",
                "needs_input",
                "not_applicable"
              ]
            }
          }
        }
      }
    }
  },
  "gate_programs": {
    "reproduction-routing": {
      "rules": [
        {
          "outcome": "bypass",
          "when": {
            "operation": "any",
            "predicates": [
              {
                "operation": "compare",
                "left": {
                  "source": "path",
                  "path": "/work_kind"
                },
                "comparison": "equal",
                "right": {
                  "source": "literal",
                  "value": "feature_request"
                }
              }
            ]
          }
        },
        {
          "outcome": "check",
          "when": {
            "operation": "any",
            "predicates": [
              {
                "operation": "compare",
                "left": {
                  "source": "path",
                  "path": "/reproducibility"
                },
                "comparison": "equal",
                "right": {
                  "source": "literal",
                  "value": "unknown"
                }
              },
              {
                "operation": "compare",
                "left": {
                  "source": "path",
                  "path": "/reproducibility"
                },
                "comparison": "equal",
                "right": {
                  "source": "literal",
                  "value": "not_reproduced"
                }
              },
              {
                "operation": "compare",
                "left": {
                  "source": "path",
                  "path": "/reproducibility"
                },
                "comparison": "equal",
                "right": {
                  "source": "literal",
                  "value": "needs_research"
                }
              },
              {
                "operation": "compare",
                "left": {
                  "source": "path",
                  "path": "/reproducibility"
                },
                "comparison": "equal",
                "right": {
                  "source": "literal",
                  "value": "reproduced"
                }
              }
            ]
          }
        }
      ],
      "fallback": "needs_input",
      "default_output": {
        "value": {
          "mapping": "pointer",
          "path": ""
        }
      }
    }
  },
  "gate_bindings": {
    "reproduction-needed": {
      "program": "reproduction-routing",
      "precondition": {
        "operation": "exists",
        "operand": {
          "source": "path",
          "path": "/work_kind"
        }
      }
    }
  }
}
