{
  "schemas": {
    "classification_observations": {
      "identity": "factory.triage.classification_observations",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "work_kind": {
            "required": true,
            "value": {
              "type": "enum",
              "values": ["defect", "feature_request"]
            }
          },
          "size": {
            "required": true,
            "value": {
              "type": "enum",
              "values": ["small", "medium", "large"]
            }
          },
          "risk": {
            "required": true,
            "value": {
              "type": "enum",
              "values": ["low", "medium", "high", "critical"]
            }
          },
          "recommended_route": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "escalation",
                "rejection",
                "already_fixed",
                "verification_only",
                "research",
                "requirements",
                "development"
              ]
            }
          },
          "reproducibility": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "reproduced",
                "not_reproduced",
                "unknown",
                "needs_research",
                "needs_input",
                "not_applicable"
              ]
            }
          },
          "component": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "server",
                "console",
                "agent",
                "infrastructure",
                "documentation",
                "other"
              ]
            }
          },
          "severity": {
            "required": true,
            "value": {
              "type": "enum",
              "values": ["advisory", "low", "medium", "high", "critical"]
            }
          },
          "dependencies": {
            "required": true,
            "value": {
              "type": "array",
              "min_items": 0,
              "max_items": 64,
              "item": {
                "type": "object",
                "fields": {
                  "run_id": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 36,
                      "max_bytes": 36
                    }
                  },
                  "work_id": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 36,
                      "max_bytes": 36
                    }
                  },
                  "work_digest": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 64,
                      "max_bytes": 64
                    }
                  },
                  "terminal": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 1,
                      "max_bytes": 128
                    }
                  }
                }
              }
            }
          },
          "priority_assessment": {
            "required": true,
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    },
    "classification_producer": {
      "identity": "factory.triage.classification_producer",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "build_id": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 36
            }
          },
          "attempt_id": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 36
            }
          },
          "job_id": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 36
            }
          }
        }
      }
    },
    "classification_priority": {
      "identity": "factory.triage.classification_priority",
      "version": "v1",
      "shape": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      }
    },
    "classification_digest": {
      "identity": "factory.triage.classification_digest",
      "version": "v1",
      "shape": {
        "type": "string",
        "min_bytes": 64,
        "max_bytes": 64
      }
    },
    "classification_facts": {
      "identity": "factory.triage.classification_facts",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "assessment": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_observations"
            }
          },
          "input_digest": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_digest"
            }
          },
          "reproduced": {
            "required": true,
            "value": {
              "type": "boolean"
            }
          },
          "already_fixed": {
            "required": true,
            "value": {
              "type": "boolean"
            }
          },
          "verification_only": {
            "required": true,
            "value": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "classification_gate_input": {
      "identity": "factory.triage.classification_gate_input",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "assessment": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_observations"
            }
          },
          "verified_assessment": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_observations"
            }
          },
          "expected_input": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_digest"
            }
          },
          "evidence_input": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_digest"
            }
          },
          "fresh_until": {
            "required": true,
            "value": {
              "type": "integer",
              "minimum": -62135596800000,
              "maximum": 253402300799999
            }
          },
          "producer": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_producer"
            }
          },
          "evidence_producer": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_producer"
            }
          },
          "admission_priority": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_priority"
            }
          },
          "admission_risk": {
            "required": true,
            "value": {
              "type": "enum",
              "values": ["low", "medium", "high", "critical"]
            }
          },
          "reproduced_verified": {
            "required": true,
            "value": {
              "type": "boolean"
            }
          },
          "already_fixed_verified": {
            "required": true,
            "value": {
              "type": "boolean"
            }
          },
          "verification_only_verified": {
            "required": true,
            "value": {
              "type": "boolean"
            }
          },
          "result_fresh_until": {
            "required": true,
            "value": {
              "type": "integer",
              "minimum": -62135596800000,
              "maximum": 253402300799999
            }
          }
        }
      }
    },
    "summary": {
      "identity": "factory.triage.classification_summary",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "assessment": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_observations"
            }
          },
          "admission_priority": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_priority"
            }
          },
          "admission_risk": {
            "required": true,
            "value": {
              "type": "enum",
              "values": ["low", "medium", "high", "critical"]
            }
          },
          "accepted": {
            "required": true,
            "value": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
