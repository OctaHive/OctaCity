{
  "schemas": {
    "classification_observations": {
      "identity": "factory.triage.classification_observations",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "work_kind": {
            "required": true,
            "value": {
              "type": "enum",
              "values": ["defect", "feature_request"]
            }
          },
          "size": {
            "required": true,
            "value": {
              "type": "enum",
              "values": ["small", "medium", "large"]
            }
          },
          "risk": {
            "required": true,
            "value": {
              "type": "enum",
              "values": ["low", "medium", "high", "critical"]
            }
          },
          "recommended_route": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "escalation",
                "rejection",
                "already_fixed",
                "verification_only",
                "research",
                "requirements",
                "development"
              ]
            }
          },
          "reproducibility": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "reproduced",
                "not_reproduced",
                "unknown",
                "needs_research",
                "needs_input",
                "not_applicable"
              ]
            }
          },
          "component": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "server",
                "console",
                "agent",
                "infrastructure",
                "documentation",
                "other"
              ]
            }
          },
          "severity": {
            "required": true,
            "value": {
              "type": "enum",
              "values": ["advisory", "low", "medium", "high", "critical"]
            }
          },
          "dependencies": {
            "required": true,
            "value": {
              "type": "array",
              "min_items": 0,
              "max_items": 64,
              "item": {
                "type": "object",
                "fields": {
                  "run_id": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 36,
                      "max_bytes": 36
                    }
                  },
                  "work_id": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 36,
                      "max_bytes": 36
                    }
                  },
                  "work_digest": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 64,
                      "max_bytes": 64
                    }
                  },
                  "terminal": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 1,
                      "max_bytes": 128
                    }
                  }
                }
              }
            }
          },
          "priority_assessment": {
            "required": true,
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    },
    "classification_priority": {
      "identity": "factory.triage.classification_priority",
      "version": "v1",
      "shape": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      }
    },
    "classification_digest": {
      "identity": "factory.triage.classification_digest",
      "version": "v1",
      "shape": {
        "type": "string",
        "min_bytes": 64,
        "max_bytes": 64
      }
    },
    "classification_gate_input": {
      "identity": "factory.triage.classification_gate_input",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "assessment": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_observations"
            }
          },
          "admission_priority": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_priority"
            }
          },
          "admission_risk": {
            "required": true,
            "value": {
              "type": "enum",
              "values": ["low", "medium", "high", "critical"]
            }
          },
          "fresh_until": {
            "required": true,
            "value": {
              "type": "integer",
              "minimum": -62135596800000,
              "maximum": 253402300799999
            }
          },
          "result_fresh_until": {
            "required": true,
            "value": {
              "type": "integer",
              "minimum": -62135596800000,
              "maximum": 253402300799999
            }
          },
          "command_policy": {
            "required": true,
            "value": {
              "type": "array",
              "min_items": 0,
              "max_items": 1,
              "item": {
                "type": "reference",
                "schema": "command_policy"
              }
            }
          },
          "observed_policy": {
            "required": true,
            "value": {
              "type": "array",
              "min_items": 0,
              "max_items": 1,
              "item": {
                "type": "reference",
                "schema": "command_policy"
              }
            }
          },
          "expected_scope": {
            "required": true,
            "value": {
              "type": "array",
              "min_items": 0,
              "max_items": 1,
              "item": {
                "type": "reference",
                "schema": "command_scope"
              }
            }
          },
          "reported_scope": {
            "required": true,
            "value": {
              "type": "array",
              "min_items": 0,
              "max_items": 1,
              "item": {
                "type": "reference",
                "schema": "command_scope"
              }
            }
          },
          "allowed_dependencies": {
            "required": true,
            "value": {
              "type": "array",
              "min_items": 0,
              "max_items": 64,
              "item": {
                "type": "object",
                "fields": {
                  "run_id": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 36,
                      "max_bytes": 36
                    }
                  },
                  "work_id": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 36,
                      "max_bytes": 36
                    }
                  },
                  "work_digest": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 64,
                      "max_bytes": 64
                    }
                  },
                  "terminal": {
                    "required": true,
                    "value": {
                      "type": "string",
                      "min_bytes": 1,
                      "max_bytes": 128
                    }
                  }
                }
              }
            }
          },
          "finding": {
            "required": true,
            "value": {
              "type": "enum",
              "values": ["absent", "matched", "not_matched", "indeterminate"]
            }
          },
          "command_status": {
            "required": true,
            "value": {
              "type": "enum",
              "values": [
                "absent",
                "completed",
                "environment_unavailable",
                "needs_input"
              ]
            }
          },
          "evidence": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "command_evidence"
            }
          }
        }
      }
    },
    "summary": {
      "identity": "factory.triage.classification_summary",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "assessment": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_observations"
            }
          },
          "admission_priority": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_priority"
            }
          },
          "admission_risk": {
            "required": true,
            "value": {
              "type": "enum",
              "values": ["low", "medium", "high", "critical"]
            }
          },
          "accepted": {
            "required": true,
            "value": {
              "type": "boolean"
            }
          },
          "evidence": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "command_evidence"
            }
          }
        }
      }
    },
    "command_pin": {
      "identity": "factory.triage.command_pin",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "identity": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 128
            }
          },
          "version": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 128
            }
          },
          "digest": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_digest"
            }
          }
        }
      }
    },
    "command_subject": {
      "identity": "factory.triage.command_subject",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "project_id": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 36,
              "max_bytes": 36
            }
          },
          "repository_id": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 36,
              "max_bytes": 36
            }
          },
          "base_revision": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 512
            }
          }
        }
      }
    },
    "command_policy": {
      "identity": "factory.triage.command_policy",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "command": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "command_pin"
            }
          },
          "tool": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "command_pin"
            }
          },
          "plugin": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "command_pin"
            }
          },
          "schema": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "command_pin"
            }
          },
          "environment": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "command_pin"
            }
          },
          "criterion": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "command_pin"
            }
          },
          "task_digest": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_digest"
            }
          },
          "result_output": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 128
            }
          },
          "build_configuration": {
            "required": true,
            "value": {
              "type": "object",
              "fields": {
                "id": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 36,
                    "max_bytes": 36
                  }
                },
                "project_id": {
                  "required": true,
                  "value": {
                    "type": "string",
                    "min_bytes": 36,
                    "max_bytes": 36
                  }
                },
                "version": {
                  "required": true,
                  "value": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  }
                },
                "definition_digest": {
                  "required": true,
                  "value": {
                    "type": "reference",
                    "schema": "classification_digest"
                  }
                }
              }
            }
          }
        }
      }
    },
    "command_scope": {
      "identity": "factory.triage.command_scope",
      "version": "v1",
      "shape": {
        "type": "object",
        "fields": {
          "input_digest": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "classification_digest"
            }
          },
          "subject": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "command_subject"
            }
          },
          "command": {
            "required": true,
            "value": {
              "type": "reference",
              "schema": "command_pin"
            }
          },
          "output": {
            "required": true,
            "value": {
              "type": "string",
              "min_bytes": 1,
              "max_bytes": 128
            }
          }
        }
      }
    },
    "command_evidence": {
      "identity": "factory.triage.command_evidence",
      "version": "v1",
      "shape": {
        "type": "externally_tagged",
        "variants": {
          "absent": null,
          "observed": {
            "type": "object",
            "fields": {
              "policy": {
                "required": true,
                "value": {
                  "type": "reference",
                  "schema": "command_policy"
                }
              },
              "scope": {
                "required": true,
                "value": {
                  "type": "reference",
                  "schema": "command_scope"
                }
              },
              "owner_input_digest": {
                "required": true,
                "value": {
                  "type": "reference",
                  "schema": "classification_digest"
                }
              },
              "record_digest": {
                "required": true,
                "value": {
                  "type": "reference",
                  "schema": "classification_digest"
                }
              },
              "status": {
                "required": true,
                "value": {
                  "type": "enum",
                  "values": [
                    "completed",
                    "environment_unavailable",
                    "needs_input"
                  ]
                }
              },
              "finding": {
                "required": true,
                "value": {
                  "type": "enum",
                  "values": ["matched", "not_matched", "indeterminate"]
                }
              },
              "fresh_until": {
                "required": true,
                "value": {
                  "type": "integer",
                  "minimum": -62135596800000,
                  "maximum": 253402300799999
                }
              },
              "producer": {
                "required": true,
                "value": {
                  "type": "object",
                  "fields": {
                    "build_id": {
                      "required": true,
                      "value": {
                        "type": "string",
                        "min_bytes": 1,
                        "max_bytes": 36
                      }
                    },
                    "attempt_id": {
                      "required": true,
                      "value": {
                        "type": "string",
                        "min_bytes": 1,
                        "max_bytes": 36
                      }
                    },
                    "job_id": {
                      "required": true,
                      "value": {
                        "type": "string",
                        "min_bytes": 1,
                        "max_bytes": 36
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
