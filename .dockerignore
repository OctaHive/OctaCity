# Locked UI production build inputs. The ignored OpenAPI schema is generated
# inside the builder from the checked-in Rust contract and generator script.
# Tests remain because the checked-in TypeScript project includes them in its
# type-checking boundary.
!ui/
ui/*
!ui/.npmrc
!ui/.node-version
!ui/architecture-policy.json
!ui/index.html
!ui/package.json
!ui/pnpm-lock.yaml
!ui/playwright.config.ts
!ui/scripts/
