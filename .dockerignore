!ui/scripts/verify-architecture.mjs
!ui/scripts/compact-message-catalogs.mjs
!ui/scripts/compact-message-catalogs.d.mts
!ui/tsconfig.json
!ui/vite.config.ts
!ui/public/
!ui/public/**
!ui/src/
!ui/src/**
!ui/tests/
!ui/tests/**

