# The local stand uses a default-deny build context. The verifier treats this
# file as the policy source and checks its security invariants and examples.
**

# Workspace manifests and license.
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!LICENSE

# Production Rust manifests and sources. Directories must be re-included
# before Docker can traverse them; each reopened level is immediately denied
# again so only the subsequent file rules survive.
!agent/
agent/*
!agent/*/
agent/*.*
agent/*/*
!agent/*/Cargo.toml
!agent/*/build.rs
!agent/*/src/
!agent/*/src/**
!agent/octacity-source-plugin/README.md
!server/
server/*
!server/*/
server/*.*
server/*/*
!server/*/Cargo.toml
!server/*/build.rs
!server/*/src/
!server/*/src/**
!server/api/*/
server/api/*.*
server/api/*/*
!server/api/*/Cargo.toml
!server/api/*/build.rs
!server/api/*/src/
!server/api/*/src/**
!server/core/*/
server/core/*.*
server/core/*/*
!server/core/*/Cargo.toml
!server/core/*/build.rs
!server/core/*/src/
!server/core/*/src/**
!server/infrastructure/*/
server/infrastructure/*.*
server/infrastructure/*/*
!server/infrastructure/*/Cargo.toml
!server/infrastructure/*/build.rs
!server/infrastructure/*/src/
!server/infrastructure/*/src/**
!server/infrastructure/octacity-server-store-postgres/migrations/
!server/infrastructure/octacity-server-store-postgres/migrations/**
!server/protocols/*/
server/protocols/*.*
server/protocols/*/*
!server/protocols/*/Cargo.toml
!server/protocols/*/build.rs
!server/protocols/*/src/
!server/protocols/*/src/**
!shared/
shared/*
!shared/*/
shared/*.*
shared/*/*
!shared/*/Cargo.toml
!shared/*/build.rs
!shared/*/src/
!shared/*/src/**

# Locked UI production build inputs. Tests remain because the checked-in
# TypeScript project includes them in its type-checking boundary.
!ui/
ui/*
!ui/.generated/
ui/.generated/*
!ui/.generated/api/
ui/.generated/api/*
!ui/.generated/api/schema.d.ts
!ui/.npmrc
!ui/index.html
!ui/package.json
!ui/pnpm-lock.yaml
!ui/playwright.config.ts
!ui/tsconfig.json
!ui/vite.config.ts
!ui/public/
!ui/public/**
!ui/src/
!ui/src/**
!ui/tests/
!ui/tests/**

# Repository-owned local-stand build definitions and immutable input policy.
!deployment/
deployment/*
!deployment/local-stand/
deployment/local-stand/*
!deployment/local-stand/*.Dockerfile
!deployment/local-stand/*.json

# Absolute exclusions are intentionally last so a later broad allow rule can
# never admit VCS data, build products, credentials, or mutable stand state.
.git
.git/**
**/.git
**/.git/**
target
target/**
**/target
**/target/**
ui/node_modules
ui/node_modules/**
**/node_modules
**/node_modules/**
ui/dist
ui/dist/**
**/dist
**/dist/**
.pnpm-store
.pnpm-store/**
**/.pnpm-store
**/.pnpm-store/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.pyo
.env
.env.*
**/.env
**/.env.*
**/*.pem
**/*.key
**/secrets
**/secrets/**
.local-stand
.local-stand/**
deployment/local-stand/generated
deployment/local-stand/generated/**
deployment/local-stand/state
deployment/local-stand/state/**
**/.DS_Store
**/.idea
**/.idea/**
