{
  "reader": {
    "identity": "github-issues",
    "version": "v2",
    "readable": { "states": ["open", "closed"], "labels": [] },
    "predicate_states": ["open", "closed"],
    "predicate_label_presence": true,
    "preparation": {
      "mapping": {
        "acceptance": { "kind": "body_section", "value": "## Acceptance" },
        "require_body": true,
        "max_title_bytes": 4096,
        "max_body_bytes": 262144,
        "max_artifact_bytes": 1048576,
        "retention_millis": 86400000
      },
      "source": { "kind": "default_reference" },
      "classification": { "priority": 40, "risk": "medium", "metadata": {} }
    },
    "polling": {
      "page_items": 25,
      "max_pages": 4,
      "max_items": 100,
      "max_bytes": 1048576,
      "max_page_bytes": 262144,
      "overlap_millis": 60000,
      "reconciliation_interval_millis": 3600000,
      "retention_millis": 86400000
    }
  },
  "selector": {
    "identity": "all-issues",
    "definition": { "state": "all", "all_of": [], "any_of": [], "none_of": [] }
  },
  "reporter": {
    "identity": "github-status",
    "version": "v1",
    "reporting": { "editable": { "labels": [], "states": ["open", "closed"] } },
    "issue_delivery": {
      "retry": { "max_attempts": 8, "retry_delay_millis": 1000 },
      "window_millis": 300000,
      "budget": {
        "max_attempts": 1,
        "max_elapsed_millis": 10000,
        "max_tokens": 0,
        "max_cost_micro_units": 0,
        "max_output_bytes": 131072
      }
    }
  },
  "mapping": {
    "identity": "native-status",
    "definition": {
      "config_version": 1,
      "editable": true,
      "editable_states": ["open", "closed"],
      "managed_label_groups": {},
      "statuses": {
        "native-open": { "add": [], "remove": [], "state": "open" },
        "native-closed": { "add": [], "remove": [], "state": "closed" }
      }
    }
  }
}
